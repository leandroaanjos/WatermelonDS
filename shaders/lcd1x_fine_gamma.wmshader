// @watermelon-shader 1
// @name lcd1x_fine_gamma
// @parameter BRIGHTEN_SCANLINES "Scanline brightness" 16.0 1.0 32.0 0.5
// @parameter BRIGHTEN_LCD "LCD brightness" 7.0 1.0 12.0 0.1
// @parameter GRID_DENSITY "Grid density" 1.4166667 0.5 4.0 0.01
// @parameter GAMMA_STRENGTH "Gamma effect strength" 0.5 0.0 1.0 0.05
// Fine LCD grid with the zfast LCD gamma approximation.
/*
 * Adapted from zfast_lcd_standard, Copyright (C) 2017 Greg Hogan (SoltanGris42).
 * SPDX-License-Identifier: GPL-2.0-or-later
 * This program is free software: you can redistribute it and/or modify it
 * under the terms of the GNU General Public License as published by the
 * Free Software Foundation, either version 2, or (at your option) any later version.
 * This program is distributed WITHOUT ANY WARRANTY; without even the implied
 * warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
 * See https://www.gnu.org/licenses/old-licenses/gpl-2.0.html for the license.
 */

vec3 watermelonShader(vec2 uv, vec2 pixel, vec3 color)
{
    vec2 grid = pixel * GRID_DENSITY;
    vec2 angle = 6.283185307 * (grid - 0.25);
    vec2 visibility = smoothstep(vec2(2.0), vec2(3.0),
        vec2(1.0) / max(fwidth(grid), vec2(0.0001)));
    vec2 wave = sin(angle) * visibility;
    float yfactor = (BRIGHTEN_SCANLINES + wave.y) / (BRIGHTEN_SCANLINES + 1.0);
    float xfactor = (BRIGHTEN_LCD + wave.x) / (BRIGHTEN_LCD + 1.0);
    vec3 shaded = color * yfactor * xfactor;
    return mix(shaded, shaded * (0.6 + 0.4 * shaded), GAMMA_STRENGTH);
}
