// @watermelon-shader 1
// @name LCD3x
// @parameter BRIGHTEN_SCANLINES "Brighten Scanlines" 16.0 1.0 32.0 0.5
// @parameter BRIGHTEN_LCD "Brighten LCD" 4.0 1.0 12.0 0.1
// Original author: Gigaherz. License: Public domain.
// Adapted from lcd3x.slang to the WatermelonDS single-pass interface.
// The grid follows native DS pixels, independently of internal rendering scale.

vec3 watermelonShader(vec2 uv, vec2 pixel, vec3 color)
{
    vec2 omega = 3.141592654 * 2.0 * wmSourceSize;
    const vec3 offsets = 3.141592654 * vec3(0.5, 0.5 - 2.0 / 3.0, 0.5 - 4.0 / 3.0);
    vec2 angle = uv * omega;

    float brighten_scanlines = BRIGHTEN_SCANLINES;
    float brighten_lcd = BRIGHTEN_LCD;
    float yfactor = (brighten_scanlines + sin(angle.y)) / (brighten_scanlines + 1.0);
    vec3 xfactors = (brighten_lcd + sin(angle.x + offsets)) / (brighten_lcd + 1.0);

    return yfactor * xfactors * color;
}
